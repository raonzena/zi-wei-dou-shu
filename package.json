    "iztro": "2.6.1",
    "jotai": "3.0.0",
    "korean-lunar-calendar": "0.4.0",
    "next": "16.3.4",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
