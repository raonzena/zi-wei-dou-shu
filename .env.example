# 운영 Supabase 프로젝트 URL입니다. 공개 가능한 설정입니다.
# 첫 화면·빌드·테스트는 환경변수 없이도 실행됩니다.
NEXT_PUBLIC_SUPABASE_URL=https://zequziabehplkeaufjcq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버에서만 사용하며 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
SUPABASE_SECRET_KEY=

# AI 설명을 사용할 때만 설정합니다. 서버 전용이며 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
OPENAI_API_KEY=

# 운영 AI 해석은 현재 중지 상태입니다. false로 설정하면 화면과 서버 호출을 모두 비활성화합니다.
AI_EXPLANATION_ENABLED=false

# 결과 중복 판별에도 사용하므로 AI 비활성 상태에서도 설정합니다.
# AI 한도와 결과 식별은 별도 HMAC scope를 사용합니다.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"로 생성합니다.
# 재배포마다 바꾸지 않습니다. 변경하면 기존 IP별 제한/중복 식별과 결과 재사용 키가 변경됩니다.
AI_USAGE_HMAC_SECRET=
AI_HOURLY_LIMIT=3
AI_DAILY_LIMIT=20
# USD의 백만분의 1 단위. 2000000 = $2. 추정치이며 제공자 청구 상한은 아닙니다.
AI_DAILY_BUDGET_MICROUSD=2000000

# Google AdSense 승인이 끝난 뒤 결과 화면 광고를 활성화할 때 설정합니다.
# 두 값은 공개 식별자이며, 둘 중 하나라도 없거나 형식이 잘못되면 광고 코드를 불러오지 않습니다.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_RESULT_SLOT_ID=
